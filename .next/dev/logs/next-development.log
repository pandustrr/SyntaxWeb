116:   vec2 focalPx = uFocal * uResolution.xy;
117:   vec2 uv = (vUv * uResolution.xy - focalPx) / uResolution.y;
118: 
119:   vec2 mouseNorm = uMouse - vec2(0.5);
120:   vec2 mouseOffset = mouseNorm * 0.1 * uMouseActiveFactor;
121:   uv += mouseOffset; // Global Parallax for all stars
122: 
123:   if (uAutoCenterRepulsion > 0.0) {
124:     vec2 centerUV = vec2(0.0, 0.0);
125:     float centerDist = length(uv - centerUV);
126:     vec2 repulsion = normalize(uv - centerUV) * (uAutoCenterRepulsion / (centerDist + 0.1));
127:     uv += repulsion * 0.05;
128:   } 
129:   
130:   // Interaction (Attraction / Repulsion)
131:   vec2 mousePosUV = (uMouse * uResolution.xy - focalPx) / uResolution.y;
132:   float mouseDist = length(uv - mousePosUV);
133: 
134:   if (uMouseAttraction) {
135:     // Black Hole Suction: Pulls stars towards the mouse
136:     vec2 dirAway = uv - mousePosUV;
137:     float d = length(dirAway);
138:     // Exponential suction force
139:     float force = (uAttractionStrength * 0.05) / (d + 0.2);
140:     force = min(force, 1.2); // Cap the distortion
141:     uv += dirAway * force * uMouseActiveFactor;
142:   } else if (uMouseRepulsion) {
143:     float invDist = 1.0 / (mouseDist + 0.15);
144:     float force = (uRepulsionStrength * 0.1) * invDist;
145:     vec2 repulsion = normalize(uv - mousePosUV) * force;
146:     uv += repulsion * uMouseActiveFactor;
147:   }
148: 
149:   float autoRotAngle = uTime * uRotationSpeed;
150:   mat2 autoRot = mat2(cos(autoRotAngle), -sin(autoRotAngle), sin(autoRotAngle), cos(autoRotAngle));
151:   uv = autoRot * uv;
152: 
153:   uv = mat2(uRotation.x, -uRotation.y, uRotation.y, uRotation.x) * uv;
154: 
155:   vec3 col = vec3(0.0);
156: 
157:   for (float i = 0.0; i < 1.0; i += 1.0 / 6.0) {
158:     if (i >= uNumLayers / 6.0) break;
159:     float depth = fract(i + uStarSpeed * uSpeed);
160:     float scale = mix(20.0 * uDensity, 0.5 * uDensity, depth);
161:     float fade = depth * smoothstep(1.0, 0.9, depth);
162:     col += StarLayer(uv * scale + i * 453.32) * fade;
163:   }
164: 
165:   if (uTransparent) {
166:     float alpha = length(col);
167:     alpha = smoothstep(0.0, 0.3, alpha);
168:     alpha = min(alpha, 1.0);
169:     gl_FragColor = vec4(col, alpha);
170:   } else {
171:     gl_FragColor = vec4(col, 1.0);
