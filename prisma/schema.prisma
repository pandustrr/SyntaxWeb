generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  username   String?      @unique
  password   String
  name       String
  role       String       @default("user")
  phone      String?
  position   String?
  baseSalary Decimal?     @db.Decimal(12, 2)
  permissions String?     @db.Text
  createdAt  DateTime     @default(now())

  // POS Multi-Tenant
  businessId Int?
  business   PosBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  shifts     PosShift[]
  orders     PosOrder[]
  attendances PosAttendance[]

  @@map("user")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@map("project")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  price       String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service")
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  image       String
  link        String?
  createdAt   DateTime @default(now())

  @@map("portfolio")
}
// ==========================================
// 2. Syntax POS - Domain Models (Multi-Tenant)
// ==========================================

model PosBusiness {
  id                Int            @id @default(autoincrement())
  name              String
  slug              String         @unique
  address           String?        @db.Text
  phone             String?
  receiptNotes      String?        @db.Text
  isActive          Boolean        @default(true)
  status            String         @default("ACTIVE") // PENDING_APPROVAL, ACTIVE, SUSPENDED, REJECTED
  isTrial           Boolean        @default(false)
  trialEndsAt       DateTime?
  logoUrl           String?
  receiptHeader     String?        @db.Text
  receiptFooter     String?        @db.Text
  receiptPaperSize  String         @default("58mm") // 58mm, 80mm
  showLogoOnReceipt Boolean        @default(true)
  showWifiOnReceipt Boolean        @default(false)
  wifiPassword      String?
  taxPercent        Decimal        @default(10.00) @db.Decimal(5, 2)
  isTaxInclusive    Boolean        @default(false)
  servicePercent    Decimal        @default(0.00) @db.Decimal(5, 2)
  planId            Int?
  plan              PosSubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscribedAt      DateTime?
  subscriptionEndsAt DateTime?

  // Integrasi Absensi Eksternal (SLOVV)
  slovvBaseUrl      String?        @default("https://myabsensislovv.my.id")
  slovvUsername     String?
  slovvPassword     String?
  slovvSyncEnabled  Boolean        @default(false)
  lastAttendanceSync DateTime?

  // 12 Modul & Fitur Permissions Lengkap per Outlet
  enableDashboard   Boolean        @default(true)  // 1. Dashboard
  enablePos         Boolean        @default(true)  // 2. Kasir POS
  enableTables      Boolean        @default(true)  // 3. Meja Dine-in
  enableKds         Boolean        @default(true)  // 4. Dapur (KDS)
  enableProducts    Boolean        @default(true)  // 5. Produk Menu
  enableInventory   Boolean        @default(true)  // 6. Bahan & Resep (BOM)
  enableCustomers   Boolean        @default(true)  // 7. CRM & Pelanggan
  enablePromotions  Boolean        @default(true)  // 8. Voucher & Promo
  enableEmployees   Boolean        @default(true)  // 9. Karyawan & Shift
  attendanceMode    String         @default("disabled") // 10. Absensi & Gaji (disabled, internal, slovv)
  enableReports     Boolean        @default(true)  // 11. Laporan Bisnis
  enableSettings    Boolean        @default(true)  // 12. Pengaturan Toko
  rolePermissions   String?        @db.Text        // JSON: {"owner": [...], "manager": [...], "cashier": [...], "kitchen": [...]}

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  categories        PosCategory[]
  products          PosProduct[]
  tables            PosCafeTable[]
  shifts            PosShift[]
  orders            PosOrder[]
  materials         PosMaterial[]
  customers         PosCustomer[]
  promotions        PosPromotion[]
  attendances       PosAttendance[]
  payrolls          PosPayroll[]

  @@index([planId])
  @@map("pos_businesses")
}

model PosCategory {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  products   PosProduct[]

  @@index([businessId])
  @@map("pos_categories")
}

model PosProduct {
  id          Int                 @id @default(autoincrement())
  businessId  Int
  business    PosBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    PosCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  sku         String?
  description String?             @db.Text
  price       Decimal             @db.Decimal(12, 2)
  costPrice   Decimal?            @db.Decimal(12, 2)
  stock       Int                 @default(0)
  trackStock  Boolean             @default(true)
  image       String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  variants    PosProductVariant[]
  orderItems  PosOrderItem[]
  recipes     PosRecipeItem[]

  @@index([businessId])
  @@index([categoryId])
  @@map("pos_products")
}

model PosProductVariant {
  id              Int            @id @default(autoincrement())
  productId       Int
  product         PosProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String         // e.g. "Ice", "Hot", "Large"
  priceAdjustment Decimal        @default(0) @db.Decimal(12, 2)
  stock           Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orderItems      PosOrderItem[]

  @@index([productId])
  @@map("pos_product_variants")
}

model PosCafeTable {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String       // e.g. "Meja 01"
  capacity   Int          @default(4)
  status     String       @default("available") // available, occupied, reserved
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders     PosOrder[]

  @@index([businessId])
  @@map("pos_cafe_tables")
}

model PosShift {
  id           Int         @id @default(autoincrement())
  businessId   Int
  business     PosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startingCash Decimal     @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  actualCash   Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  status       String      @default("open") // open, closed
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       PosOrder[]

  @@index([businessId])
  @@index([userId])
  @@map("pos_shifts")
}

model PosOrder {
  id            Int            @id @default(autoincrement())
  businessId    Int
  business      PosBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId    Int?
  customer      PosCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId       Int?
  shift         PosShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  tableId       Int?
  table         PosCafeTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderNumber   String         @unique
  promoCode     String?
  orderType     String         @default("dine_in") // dine_in, take_away
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod String         @default("cash") // cash, qris, transfer
  paymentStatus String         @default("paid") // unpaid, paid, cancelled
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  changeAmount  Decimal        @default(0) @db.Decimal(12, 2)
  status        String         @default("completed") // pending, preparing, ready, completed, cancelled
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         PosOrderItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([shiftId])
  @@index([tableId])
  @@map("pos_orders")
}

model PosOrderItem {
  id              Int                @id @default(autoincrement())
  orderId         Int
  order           PosOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         PosProduct         @relation(fields: [productId], references: [id])
  variantId       Int?
  variant         PosProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String
  price           Decimal            @db.Decimal(12, 2)
  quantity        Int                @default(1)
  subtotal        Decimal            @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime           @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("pos_order_items")
}


model PosSubscriptionPlan {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique
  price       Decimal       @db.Decimal(12, 2)
  period      String        @default("bulan") // bulan, tahun
  description String?       @db.Text
  benefits    String        @db.Text // JSON string: ["Fitur A", "Fitur B", ...]
  badge       String?
  isPopular   Boolean       @default(false)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  businesses  PosBusiness[]

  @@map("pos_subscription_plans")
}

model PosPlatformConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("pos_platform_configs")
}

// ==========================================
// 3. Modul Absensi & Penggajian (Attendance & Payroll)
// ==========================================

model PosAttendance {
  id            Int          @id @default(autoincrement())
  businessId    Int
  business      PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeName  String       // Nama staf / karyawan
  employeeId    String?      // ID karyawan (misal EMP-UM-26-959 atau username)
  source        String       @default("internal") // "internal" atau "slovv"
  externalRefId String?      // ID Absensi asli jika dari Slovv (misal: ABS-1793375103572-96)

  date          String       // Format: YYYY-MM-DD
  checkinTime   String?      // Format: HH:mm
  checkoutTime  String?      // Format: HH:mm
  duration      String?      // Durasi kerja (misal: "7j 20m")
  lateMinutes   Int          @default(0) // Menit terlambat
  status        String       @default("Tepat Waktu") // Tepat Waktu, Terlambat, Izin, Sakit, Alpha
  shift         String?      // Jadwal shift (misal: Shift 1, Shift 2)
  photoUrl      String?      @db.LongText // Foto selfie check-in (Base64 atau URL)
  checkinLat    String?
  checkinLng    String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([businessId, externalRefId])
  @@index([businessId])
  @@index([date])
  @@map("pos_attendances")
}

model PosPayroll {
  id              Int          @id @default(autoincrement())
  businessId      Int
  business        PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  period          String       // Format: YYYY-MM (misal: 2026-10)
  employeeName    String
  employeeId      String?
  position        String?      // Jabatan (Kasir, Barista, Part Time)

  totalPresent    Int          @default(0) // Jumlah hari/shift hadir
  totalLateMinutes Int         @default(0) // Total akumulasi menit keterlambatan
  totalAlpha      Int          @default(0) // Hari alpha / mangkir
  totalLeave      Int          @default(0) // Izin / Sakit

  baseSalary      Decimal      @default(0) @db.Decimal(12, 2)
  allowance       Decimal      @default(0) @db.Decimal(12, 2) // Tunjangan transport / makan
  lateDeduction   Decimal      @default(0) @db.Decimal(12, 2) // Potongan denda keterlambatan
  alphaDeduction  Decimal      @default(0) @db.Decimal(12, 2) // Potongan denda alpha
  netSalary       Decimal      @default(0) @db.Decimal(12, 2) // Gaji bersih

  status          String       @default("draft") // draft, confirmed, paid
  paidAt          DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([businessId, period, employeeName])
  @@index([businessId])
  @@index([period])
  @@map("pos_payrolls")
}

// ==========================================
// 4. Modul Bahan, Resep, CRM & Promosi
// ==========================================

model PosMaterial {
  id           Int             @id @default(autoincrement())
  businessId   Int
  business     PosBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  category     String          @default("Lainnya")
  unit         String          @default("pcs")
  currentStock Decimal         @default(0) @db.Decimal(12, 3)
  minimumStock Decimal         @default(5) @db.Decimal(12, 3)
  costPerUnit  Decimal         @default(0) @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  recipeItems  PosRecipeItem[]

  @@index([businessId])
  @@map("pos_materials")
}

model PosRecipeItem {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    PosProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId Int
  material   PosMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(12, 3)
  unit       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
  @@index([materialId])
  @@map("pos_recipe_items")
}

model PosCustomer {
  id              Int         @id @default(autoincrement())
  businessId      Int
  business        PosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  membershipLevel String      @default("Bronze")
  totalPoints     Int         @default(0)
  totalSpend      Decimal     @default(0) @db.Decimal(14, 2)
  totalVisit      Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orders          PosOrder[]

  @@index([businessId])
  @@map("pos_customers")
}

model PosPromotion {
  id            Int         @id @default(autoincrement())
  businessId    Int
  business      PosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  code          String
  type          String      @default("percentage") // percentage, fixed
  discountValue Decimal     @db.Decimal(12, 2)
  minPurchase   Decimal     @default(0) @db.Decimal(12, 2)
  usageCount    Int         @default(0)
  usageLimit    Int?
  endDate       DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId])
  @@map("pos_promotions")
}

