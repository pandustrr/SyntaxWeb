generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  username   String?      @unique
  password   String
  name       String
  role       String       @default("user")
  createdAt  DateTime     @default(now())

  // POS Multi-Tenant
  businessId Int?
  business   PosBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  shifts     PosShift[]
  orders     PosOrder[]

  @@map("user")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@map("project")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  price       String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service")
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  image       String
  link        String?
  createdAt   DateTime @default(now())

  @@map("portfolio")
}
// ==========================================
// 2. Syntax POS - Domain Models (Multi-Tenant)
// ==========================================

model PosBusiness {
  id                Int            @id @default(autoincrement())
  name              String
  slug              String         @unique
  address           String?        @db.Text
  phone             String?
  receiptNotes      String?        @db.Text
  isActive          Boolean        @default(true)
  status            String         @default("ACTIVE") // PENDING_APPROVAL, ACTIVE, SUSPENDED, REJECTED
  logoUrl           String?
  receiptHeader     String?        @db.Text
  receiptFooter     String?        @db.Text
  receiptPaperSize  String         @default("58mm") // 58mm, 80mm
  showLogoOnReceipt Boolean        @default(true)
  showWifiOnReceipt Boolean        @default(false)
  wifiPassword      String?
  taxPercent        Decimal        @default(10.00) @db.Decimal(5, 2)
  isTaxInclusive    Boolean        @default(false)
  servicePercent    Decimal        @default(0.00) @db.Decimal(5, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  categories        PosCategory[]
  products          PosProduct[]
  tables            PosCafeTable[]
  shifts            PosShift[]
  orders            PosOrder[]

  @@map("pos_businesses")
}

model PosCategory {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  products   PosProduct[]

  @@index([businessId])
  @@map("pos_categories")
}

model PosProduct {
  id          Int                 @id @default(autoincrement())
  businessId  Int
  business    PosBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    PosCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  sku         String?
  description String?             @db.Text
  price       Decimal             @db.Decimal(12, 2)
  costPrice   Decimal?            @db.Decimal(12, 2)
  stock       Int                 @default(0)
  trackStock  Boolean             @default(true)
  image       String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  variants    PosProductVariant[]
  orderItems  PosOrderItem[]

  @@index([businessId])
  @@index([categoryId])
  @@map("pos_products")
}

model PosProductVariant {
  id              Int            @id @default(autoincrement())
  productId       Int
  product         PosProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String         // e.g. "Ice", "Hot", "Large"
  priceAdjustment Decimal        @default(0) @db.Decimal(12, 2)
  stock           Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orderItems      PosOrderItem[]

  @@index([productId])
  @@map("pos_product_variants")
}

model PosCafeTable {
  id         Int          @id @default(autoincrement())
  businessId Int
  business   PosBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String       // e.g. "Meja 01"
  capacity   Int          @default(4)
  status     String       @default("available") // available, occupied, reserved
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders     PosOrder[]

  @@index([businessId])
  @@map("pos_cafe_tables")
}

model PosShift {
  id           Int         @id @default(autoincrement())
  businessId   Int
  business     PosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startingCash Decimal     @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  actualCash   Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  status       String      @default("open") // open, closed
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       PosOrder[]

  @@index([businessId])
  @@index([userId])
  @@map("pos_shifts")
}

model PosOrder {
  id            Int            @id @default(autoincrement())
  businessId    Int
  business      PosBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftId       Int?
  shift         PosShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  tableId       Int?
  table         PosCafeTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderNumber   String         @unique
  orderType     String         @default("dine_in") // dine_in, take_away
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod String         @default("cash") // cash, qris, transfer
  paymentStatus String         @default("paid") // unpaid, paid, cancelled
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  changeAmount  Decimal        @default(0) @db.Decimal(12, 2)
  status        String         @default("completed") // pending, preparing, ready, completed, cancelled
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         PosOrderItem[]

  @@index([businessId])
  @@index([shiftId])
  @@index([tableId])
  @@map("pos_orders")
}

model PosOrderItem {
  id              Int                @id @default(autoincrement())
  orderId         Int
  order           PosOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         PosProduct         @relation(fields: [productId], references: [id])
  variantId       Int?
  variant         PosProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String
  price           Decimal            @db.Decimal(12, 2)
  quantity        Int                @default(1)
  subtotal        Decimal            @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime           @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("pos_order_items")
}

