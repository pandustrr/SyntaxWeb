{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/core": [
        "./src/core/index.ts"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/config": [
        "./src/config/constants.ts"
      ],
      "@/config/*": [
        "./src/config/*"
      ],
      "@/modules/shared": [
        "./src/modules/shared/index.ts"
      ],
      "@/modules/home": [
        "./src/modules/home/index.ts"
      ],
      "@/modules/contact": [
        "./src/modules/contact/index.ts"
      ],
      "@/modules/portfolio": [
        "./src/modules/portfolio/index.ts"
      ],
      "@/modules/pricelist": [
        "./src/modules/pricelist/index.ts"
      ],
      "@/modules/admin": [
        "./src/modules/admin/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
